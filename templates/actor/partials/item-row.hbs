{{!-- One owned-item row: name (opens the item sheet) … columns … edit/delete.
      Called as a partial block from an {{#each}} over sheet rows:
        {{#> "…/item-row.hbs"}} middle cells {{/"…/item-row.hbs"}}
      The row context is `this` ({id, name, img}). Inline edit controls in the
      block carry data-field (no `name`), so they update the item, not the actor form, and a
      stable id ({{@root.rootId}}-<item id>-<field>) so a re-render restores keyboard focus.
      Every focusable control has one. Attack-list spell rows (isSpell) add "-attack" so they
      don't collide with the same spell's Spells-list row, and are not draggable (sorting is
      per item type). An item listed on two tabs passes `idSuffix` (e.g. idSuffix="-inv" for a
      weapon's Inventory row, also listed under Attacks) so its row ids stay unique. --}}
<li class="dcc-irow{{#unless isSpell}} draggable{{/unless}}" data-item-id="{{id}}">
  <button type="button" class="dcc-iname" id="{{@root.rootId}}-{{id}}{{#if isSpell}}-attack{{/if}}{{idSuffix}}-name" data-action="editItem" data-view-only data-tooltip="{{localize 'DCC.Items.Edit'}}">
    <img src="{{img}}" alt="" width="20" height="20">
    <span>{{name}}</span>
  </button>
  {{> @partial-block}}
  <span class="dcc-icontrols">
    <button type="button" class="icon fa-solid fa-pen-to-square" id="{{@root.rootId}}-{{id}}{{#if isSpell}}-attack{{/if}}{{idSuffix}}-edit" data-action="editItem" data-view-only
            data-tooltip aria-label="{{localize 'DCC.Items.Edit'}}"></button>
    {{#if @root.editable}}
    <button type="button" class="icon fa-solid fa-trash" id="{{@root.rootId}}-{{id}}{{#if isSpell}}-attack{{/if}}{{idSuffix}}-delete" data-action="deleteItem"
            data-tooltip aria-label="{{localize 'DCC.Items.Delete'}}"></button>
    {{/if}}
  </span>
</li>
