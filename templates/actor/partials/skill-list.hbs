{{!-- Skills and Spells share the Roll20-style compact row. Editing full item
      details and hotlist membership happens on the item sheet. --}}
{{#*inline "skillCells"}}
  <span class="dcc-icell dcc-c-rank" data-tooltip="{{#if rankModified}}{{localize 'DCC.Items.RankEffectiveTooltip'}}{{/if}}">{{rankEffective}}</span>
  <span class="dcc-icell dcc-c-type">{{#if opposedAbbr}}{{localize opposedAbbr}}-{{/if}}{{localize checkTypeKey}}</span>
  <span class="dcc-icell dcc-c-roll">
    {{#if spell}}
    <button type="button" class="dcc-rollbtn dcc-skill-roll" id="{{@root.rootId}}-{{id}}-castSpell" data-action="castSpell"
            data-tooltip="{{#if isPassive}}{{localize 'DCC.Items.CastPassiveTooltip'}}{{else if lean}}{{localize 'DCC.Items.CastTooltipNoMana'}}{{else}}{{localize 'DCC.Items.CastTooltip'}}{{/if}}"
            aria-label="{{#if isPassive}}{{localize 'DCC.Items.CastPassiveTooltip'}}{{else}}{{localize 'DCC.Items.CastTooltip'}}{{/if}}">{{#if isPassive}}<i class="fa-solid fa-comment" inert></i>{{else}}{{numberFormat bonus sign=true}}{{/if}}</button>
    {{else}}
    <button type="button" class="dcc-rollbtn dcc-skill-roll" id="{{@root.rootId}}-{{id}}-rollSkill" data-action="rollSkill"
            data-tooltip="{{#if isPassive}}{{localize 'DCC.Items.PostPassiveTooltip'}}{{else}}{{localize 'DCC.Items.RollTooltip'}}{{/if}}"
            aria-label="{{#if isPassive}}{{localize 'DCC.Items.PostPassiveTooltip'}}{{else}}{{localize 'DCC.Items.RollTooltip'}}{{/if}}">{{#if isPassive}}<i class="fa-solid fa-comment" inert></i>{{else}}{{numberFormat bonus sign=true}}{{/if}}</button>
    {{/if}}
  </span>
  {{#unless lean}}
  <span class="dcc-icell dcc-c-used">
    {{#if markable}}
    <input class="dcc-icheck dcc-used-check" type="checkbox" id="{{@root.rootId}}-{{id}}-mark" data-field="system.mark" {{checked mark}}
           data-tooltip="{{localize 'DCC.Items.MarkTooltip'}}" aria-label="{{localize 'DCC.Items.Mark'}}">
    {{/if}}
  </span>
  {{/unless}}
  <span class="dcc-icell dcc-c-mods">
    <input class="dcc-icheck dcc-mods-check" type="checkbox" id="{{@root.rootId}}-{{id}}-enabled" data-field="system.enabled" {{checked enabled}}
           data-tooltip="{{localize 'DCC.Items.EnabledTooltip'}}" aria-label="{{localize 'DCC.Items.Enabled'}}">
  </span>
  {{#if hasSummary}}
  <span class="dcc-skill-summary">
    {{#if summary.length}}
    <span class="dcc-skill-summary-fields">
      {{#each summary}}
      <span class="dcc-skill-summary-field"><strong>{{localize label}}:</strong> {{value}}</span>
      {{/each}}
    </span>
    {{/if}}
  </span>
  {{/if}}
{{/inline}}
<div class="dcc-box dcc-list">
  <div class="dcc-bar dcc-bar--list">
    <span>{{#if spell}}{{localize "DCC.Items.Spells"}}{{else}}{{localize "DCC.Items.Skills"}}{{/if}}</span>
    {{#if @root.editable}}
    <button type="button" class="dcc-addbtn" id="{{@root.rootId}}-add-{{#if spell}}spell{{else}}skill{{/if}}" data-action="createItem" data-type="{{#if spell}}spell{{else}}skill{{/if}}">
      <i class="fa-solid fa-plus" inert></i> {{#if spell}}{{localize "TYPES.Item.spell"}}{{else}}{{localize "TYPES.Item.skill"}}{{/if}}
    </button>
    {{/if}}
  </div>
  <ol class="dcc-ilist {{#if spell}}dcc-ilist--spells{{else}}dcc-ilist--skills{{/if}}{{#if lean}} dcc-ilist--lean{{/if}}">
    <li class="dcc-ihead">
      <span class="dcc-c-name">{{localize "DCC.Sheet.Name"}}</span>
      <span class="dcc-c-rank">{{localize "DCC.Items.Rank"}}</span>
      <span class="dcc-c-type">{{localize "DCC.Items.Type"}}</span>
      <span class="dcc-c-roll">{{localize "DCC.Items.Roll"}}</span>
      {{#unless lean}}<span class="dcc-c-used">{{localize "DCC.Items.Used"}}</span>{{/unless}}
      <span class="dcc-c-mods">{{localize "DCC.Items.Modifiers"}}</span>
      <span class="dcc-c-ctl"></span>
    </li>
    {{#each rows}}
    {{#> "systems/dungeon-crawler-carl/templates/actor/partials/item-row.hbs" spell=../spell lean=../lean}}{{> skillCells}}{{/"systems/dungeon-crawler-carl/templates/actor/partials/item-row.hbs"}}
    {{else}}
    <li class="dcc-iempty">{{#if spell}}{{localize "DCC.Items.NoSpells"}}{{else}}{{localize "DCC.Items.NoSkills"}}{{/if}}</li>
    {{/each}}
  </ol>
</div>
