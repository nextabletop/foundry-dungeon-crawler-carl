<div class="dcc-pc-defense-viewport" role="region" aria-label="{{localize 'DCC.Tab.combat'}}" tabindex="0">
  <div class="dcc-pc-defense-grid">
    <span class="dcc-pc-defense-name">{{localize "DCC.Defense.Evade"}}<br>d20 +</span>
    <div class="dcc-fbox">
      <span class="bx">{{system.stats.dexterity.modifier}}</span>
      <span class="lab">{{localize "DCC.Defense.DexterityModifier"}}</span>
    </div>
    <span class="dcc-fop">+</span>
    <div class="dcc-fbox">
      <span class="bx dcc-pc-defense-buff">{{system.evadeBuffLabel}}</span>
      <span class="lab">{{localize "DCC.Defense.Buffs"}}</span>
    </div>
    <span class="dcc-fop">=</span>
    <div class="dcc-fbox">
      <button type="button" class="bx tot" data-action="rollEvade" data-tooltip="{{localize 'DCC.Defense.EvadeRollTooltip'}}" aria-label="{{localize 'DCC.Defense.EvadeRollTooltip'}}">{{system.evadeRollLabel}}</button>
      <span class="lab">{{localize "DCC.Defense.EvadeTotal"}}</span>
    </div>
    <div class="dcc-fbox">
      <span class="bx tot">{{system.move}}</span>
      <span class="lab">{{localize "DCC.Defense.Move"}}</span>
      <label class="dcc-fbox dcc-pc-edit-only">
        <input class="bx" type="number" step="1" name="system.moveBase" value="{{systemSource.moveBase}}" aria-label="{{localize 'DCC.Defense.MoveBase'}}">
        <span class="lab">{{localize "DCC.Defense.MoveBase"}}</span>
      </label>
    </div>
    <div class="dcc-fbox">
      <span class="bx tot">{{system.step}}</span>
      <span class="lab">{{localize "DCC.Defense.Step"}}</span>
      <label class="dcc-fbox dcc-pc-edit-only">
        <input class="bx" type="number" step="1" name="system.stepBase" value="{{systemSource.stepBase}}" aria-label="{{localize 'DCC.Defense.StepBase'}}">
        <span class="lab">{{localize "DCC.Defense.StepBase"}}</span>
      </label>
    </div>

    <span class="dcc-pc-defense-name">{{localize "DCC.Defense.DamageResistance"}}</span>
    <div class="dcc-fbox">
      <span class="bx dcc-pc-view-only">{{systemSource.armor}}</span>
      <input class="bx dcc-pc-edit-only" type="number" step="1" name="system.armor" value="{{systemSource.armor}}" aria-label="{{localize 'DCC.Defense.Armor'}}">
      <span class="lab">{{localize "DCC.Defense.Armor"}}</span>
    </div>
    <span class="dcc-fop">+</span>
    <div class="dcc-fbox">
      <span class="bx dcc-pc-defense-buff">{{system.damageResistanceBonus}}</span>
      <span class="lab">{{localize "DCC.Defense.Buffs"}}</span>
    </div>
    <span class="dcc-fop">=</span>
    <div class="dcc-fbox">
      <span class="bx tot">{{system.damageResistance}}</span>
      <span class="lab">{{localize "DCC.Defense.DamageResistanceTotal"}}</span>
    </div>
    <div class="dcc-fbox">
      <span class="bx dcc-pc-view-only">{{systemSource.aiFavor}}</span>
      <input class="bx dcc-pc-edit-only" type="number" step="1" name="system.aiFavor" value="{{systemSource.aiFavor}}" aria-label="{{localize 'DCC.Header.AiFavor'}}">
      <span class="lab">{{localize "DCC.Header.AiFavor"}}</span>
    </div>
    <div class="dcc-fbox">
      <span class="bx dcc-pc-view-only">{{systemSource.size}}</span>
      <input class="bx dcc-pc-edit-only" type="text" name="system.size" value="{{systemSource.size}}" aria-label="{{localize 'DCC.Defense.Size'}}">
      <span class="lab">{{localize "DCC.Defense.Size"}}</span>
    </div>
  </div>
</div>
