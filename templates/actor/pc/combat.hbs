<section class="dcc-box dcc-pc-combat">
  <div class="dcc-bar">
    <span>{{localize "DCC.Tab.combat"}}</span>
    {{#if editable}}
    <label class="dcc-pc-edit-toggle dcc-pc-combat-edit" data-tooltip="{{localize 'DCC.Defense.EditCombat'}}">
      <input type="checkbox" name="system.pcCombatEdit" {{checked systemSource.pcCombatEdit}} aria-label="{{localize 'DCC.Defense.EditCombat'}}">
      <i class="fa-solid fa-pen-to-square" aria-hidden="true"></i> {{localize "DCC.Defense.Edit"}}
    </label>
    {{/if}}
  </div>
  {{> "systems/dungeon-crawler-carl/templates/actor/partials/defenses.hbs"}}
  {{> "systems/dungeon-crawler-carl/templates/actor/partials/unresolved.hbs"}}
</section>
