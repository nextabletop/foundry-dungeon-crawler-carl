{{!-- Identity header (R20 components/_header.pug): the portrait with the advancement buttons under
      it on the left; the identity fields in two rows on the right. --}}
<header class="dcc-header dcc-box">
  <div class="dcc-headgrid">
    <div class="dcc-headside">
      <img class="dcc-portrait" src="{{document.img}}" alt="{{document.name}}" {{#if editable}}data-action="editImage" data-edit="img" data-tooltip="{{localize 'DCC.Sheet.EditImage'}}"{{/if}}>
      {{!-- Advancement (R20 header .dcc-hdr-actions; DCCActor#endSession / endFloor / levelUp /
            undoAdvancement). End Floor and Level Up also honour the GM screen gates
            (DCCActor#advancementGate); the safehouse badge shows while the GM's safehouse is open.
            Tooltips sit on wrapper spans: a disabled button fires no pointer events, so a tooltip
            on the button itself would never explain why it is disabled. A disabled End Floor /
            Level Up / Undo also points aria-describedby at a visually-hidden copy of that reason. --}}
      <div class="dcc-hdr-actions">
        {{!--
        <span class="dcc-advancement" data-tooltip="{{localize 'DCC.Advance.EndSessionTooltip'}}">
          <button type="button" class="dcc-rollbtn" id="{{@root.rootId}}-advancement-endSession" data-action="advancementEndSession"
                  {{disabled (not advancement.canAct)}}>{{localize "DCC.Advance.EndSession"}}</button>
        </span>
        <span class="dcc-advancement" data-tooltip="{{localize advancement.endFloorTooltip n=advancement.floorEndsAvailable}}">
          <button type="button" class="dcc-rollbtn" id="{{@root.rootId}}-advancement-endFloor" data-action="advancementEndFloor"
                  {{#unless advancement.canEndFloor}}aria-describedby="{{@root.rootId}}-advancement-endFloor-why"{{/unless}}
                  {{disabled (not advancement.canEndFloor)}}>{{localize "DCC.Advance.EndFloor"}}</button>
          {{#unless advancement.canEndFloor}}<span class="dcc-sr-only" id="{{@root.rootId}}-advancement-endFloor-why">{{localize advancement.endFloorTooltip n=advancement.floorEndsAvailable}}</span>{{/unless}}
        </span>
        <span class="dcc-advancement" data-tooltip="{{localize advancement.levelUpTooltip}}">
          <button type="button" class="dcc-rollbtn dcc-rollbtn--hot" id="{{@root.rootId}}-advancement-levelUp" data-action="advancementLevelUp"
                  {{#unless advancement.canLevelUp}}aria-describedby="{{@root.rootId}}-advancement-levelUp-why"{{/unless}}
                  {{disabled (not advancement.canLevelUp)}}>{{localize "DCC.Advance.LevelUp"}}</button>
          {{#unless advancement.canLevelUp}}<span class="dcc-sr-only" id="{{@root.rootId}}-advancement-levelUp-why">{{localize advancement.levelUpTooltip}}</span>{{/unless}}
        </span>
        --}}
        {{!--
        <span class="dcc-advancement" data-tooltip="{{localize advancement.undoTooltip}}">
          <button type="button" class="dcc-rollbtn" id="{{@root.rootId}}-advancement-undo" data-action="advancementUndo"
                  {{#unless advancement.canUndo}}aria-describedby="{{@root.rootId}}-advancement-undo-why"{{/unless}}
                  {{disabled (not advancement.canUndo)}}>{{localize "DCC.Advance.Undo"}}</button>
          {{#unless advancement.canUndo}}<span class="dcc-sr-only" id="{{@root.rootId}}-advancement-undo-why">{{localize advancement.undoTooltip}}</span>{{/unless}}
        </span>
        <span class="dcc-advancement-badge" data-tooltip="{{localize 'DCC.Advance.PendingLevelsTooltip'}}">
          <span class="lbl">{{localize "DCC.Advance.PendingLevels"}}</span>
          <span class="val">{{advancement.pendingLevels}}</span>
        </span>
        <span class="dcc-advancement-badge" data-tooltip="{{localize 'DCC.Advance.StatPointsTooltip'}}">
          <span class="lbl">{{localize "DCC.Advance.StatPoints"}}</span>
          <span class="val">{{advancement.statPoints}}</span>
        </span>
        --}}
        {{!--
        {{#if advancement.safehouseBadge}}
        <span class="dcc-advancement-badge dcc-safehouse" data-tooltip="{{localize 'DCC.GmScreen.BadgeTooltip'}}">
          <span class="lbl">{{localize "DCC.GmScreen.Badge"}}</span>
        </span>
        {{/if}}
        --}}
      </div>
    </div>
    <div class="dcc-headmain dcc-pcfields">
      <label class="dcc-field dcc-f-name">
        <span class="dcc-flabel">{{localize "DCC.Sheet.Name"}}</span>
        <input class="dcc-fline" type="text" name="name" value="{{document.name}}">
      </label>
      <label class="dcc-field dcc-f-race">
        <span class="dcc-flabel">{{localize "DCC.Header.Race"}}</span>
        <input class="dcc-fline" type="text" name="system.race" value="{{systemSource.race}}">
      </label>
      <label class="dcc-field dcc-f-pronouns">
        <span class="dcc-flabel">{{localize "DCC.Header.Pronouns"}}</span>
        <input class="dcc-fline" type="text" name="system.pronouns" value="{{systemSource.pronouns}}">
      </label>
      <label class="dcc-field dcc-field--num dcc-f-level">
        <span class="dcc-flabel">{{localize "DCC.Header.Level"}}</span>
        <input class="dcc-fline" type="number" step="1" name="system.level" value="{{systemSource.level}}">
      </label>
      <label class="dcc-field dcc-f-crawler">
        <span class="dcc-flabel">{{localize "DCC.Header.CrawlerNumber"}}</span>
        <input class="dcc-fline" type="text" name="system.crawlerNumber" value="{{systemSource.crawlerNumber}}">
      </label>
      <label class="dcc-field dcc-f-class">
        <span class="dcc-flabel">{{localize "DCC.Header.Class"}}</span>
        <input class="dcc-fline" type="text" name="system.class" value="{{systemSource.class}}">
      </label>
      <label class="dcc-field dcc-field--num dcc-f-floor">
        <span class="dcc-flabel">{{localize "DCC.Header.Floor"}}</span>
        <input class="dcc-fline" type="number" step="1" name="system.floor" value="{{systemSource.floor}}">
      </label>
    </div>
  </div>
</header>
