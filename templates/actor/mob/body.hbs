{{!-- Mob stat block: one scrolling column, with Notes in its own part (mob/notes.hbs).
      No mana, hotlist, gear
      slots / accessories, advancement, crawler # / AI Favor / race / class / pronouns. Crawlers
      roll every d20: the mob exposes static targets (To-Hit, Evade) and rolls only damage,
      abilities, skills and spells. Mob roll privacy lives in Configure Sheet (DCCSheetConfig). --}}
<section class="dcc-mob">
  <header class="dcc-header dcc-box">
    <div class="dcc-headgrid">
      <img class="dcc-portrait" src="{{document.img}}" alt="{{document.name}}" {{#if editable}}data-action="editImage" data-edit="img" data-tooltip="{{localize 'DCC.Sheet.EditImage'}}"{{/if}}>
      <div class="dcc-headmain">
        <div class="dcc-mobfields">
          <label class="dcc-field">
            <span class="dcc-flabel">{{localize "DCC.Sheet.Name"}}</span>
            <input class="dcc-fline" type="text" name="name" value="{{document.name}}">
          </label>
          <label class="dcc-field dcc-mobfield-centered">
            <span class="dcc-flabel">{{localize "DCC.Header.Floor"}}</span>
            <input class="dcc-fline" type="number" step="1" name="system.floor" value="{{systemSource.floor}}">
          </label>
          <label class="dcc-field dcc-mob-descriptors">
            <span class="dcc-flabel">{{localize "DCC.Mob.Descriptors"}}</span>
            <input class="dcc-fline" type="text" name="system.descriptors" value="{{systemSource.descriptors}}"
                   placeholder="{{localize 'DCC.Mob.DescriptorsPlaceholder'}}">
          </label>
        </div>
      </div>
    </div>
  </header>

  <div class="dcc-col dcc-col-l">
    <div class="dcc-box dcc-health">
      <div class="dcc-bar">
        <span>{{localize "DCC.Health.Bar"}}</span>
        {{#if health.dying}}<span class="dcc-dying">{{localize "DCC.Health.Dead"}}</span>{{/if}}
        <button type="button" class="dcc-addbtn" data-action="healSlot">{{localize "DCC.Health.HealSlot"}}</button>
      </div>
      {{> "systems/dungeon-crawler-carl/templates/actor/partials/health-bar.hbs"}}
    </div>

    <div class="dcc-box dcc-mob-combat">
      <div class="dcc-bar">{{localize "DCC.Tab.combat"}}</div>
      <div class="dcc-mobstrip">
        {{#if editable}}
        <label class="dcc-mob-edit" data-tooltip="{{localize 'DCC.Mob.EditCombat'}}">
          <input type="checkbox" name="system.mobCombatEdit" {{checked systemSource.mobCombatEdit}}
                 aria-label="{{localize 'DCC.Mob.EditCombat'}}">
          <i class="fa-solid fa-pen-to-square" aria-hidden="true"></i>
        </label>
        {{/if}}
        <div class="dcc-mob-combat-grid" role="region" aria-label="{{localize 'DCC.Tab.combat'}}" tabindex="0">
          <div class="dcc-mob-combat-stat">
            <span class="dcc-flabel">{{localize "DCC.Header.Level"}}</span>
            <span class="dcc-mob-total">{{system.level}}</span>
            <label class="dcc-mob-edit-fields">
              <span class="dcc-mob-part">
                <input class="dcc-mob-input" type="number" step="1" name="system.level" value="{{systemSource.level}}"
                       aria-label="{{localize 'DCC.Header.Level'}}" data-tooltip="{{localize 'DCC.Mob.LevelTooltip'}}">
                <span class="dcc-flabel">{{localize "DCC.Mob.Base"}}</span>
              </span>
            </label>
          </div>
          <div class="dcc-mob-combat-stat" data-tooltip="{{localize 'DCC.Mob.SurpriseTooltip'}}">
            <span class="dcc-flabel">{{localize "DCC.Mob.Surprise"}}</span>
            <span class="dcc-mob-total">{{system.mobSurprise}}</span>
            <div class="dcc-mob-edit-fields">
              <label class="dcc-mob-part">
                <input class="dcc-mob-input" type="number" step="1" name="system.surprise" value="{{systemSource.surprise}}"
                       aria-label="{{localize 'DCC.Mob.SurpriseBase'}}">
                <span class="dcc-flabel">{{localize "DCC.Mob.Base"}}</span>
              </label>
              <span class="dcc-mob-op">{{localize "DCC.Mob.PlusFloor"}}</span>
            </div>
          </div>
          <div class="dcc-mob-combat-stat" data-tooltip="{{localize 'DCC.Mob.EvadeTooltip'}}">
            <span class="dcc-flabel">{{localize "DCC.Defense.Evade"}}</span>
            <span class="dcc-mob-total">{{system.mobEvade}}</span>
            <div class="dcc-mob-edit-fields">
              <label class="dcc-mob-part">
                <input class="dcc-mob-input" type="number" step="1" name="system.mobEvadeBase" value="{{systemSource.mobEvadeBase}}"
                       aria-label="{{localize 'DCC.Mob.EvadeBase'}}">
                <span class="dcc-flabel">{{localize "DCC.Mob.Base"}}</span>
              </label>
              <span class="dcc-mob-op">{{localize "DCC.Mob.PlusFloor"}}</span>
            </div>
          </div>
          <div class="dcc-mob-combat-stat">
            <span class="dcc-flabel">{{localize "DCC.Defense.Move"}}</span>
            <span class="dcc-mob-total" data-tooltip="{{localize 'DCC.Mob.MoveTooltip'}}">{{system.mobMove}}</span>
            <div class="dcc-mob-edit-fields">
              <label class="dcc-mob-part">
                <input class="dcc-mob-input" type="number" step="1" name="system.moveBase" value="{{systemSource.moveBase}}"
                       aria-label="{{localize 'DCC.Defense.MoveBase'}}">
                <span class="dcc-flabel">{{localize "DCC.Mob.Base"}}</span>
              </label>
              <span class="dcc-mob-op">+</span>
              <label class="dcc-mob-part">
                <input class="dcc-mob-input" type="number" step="1" name="system.stepBase" value="{{systemSource.stepBase}}"
                       aria-label="{{localize 'DCC.Defense.StepBase'}}">
                <span class="dcc-flabel">{{localize "DCC.Defense.Step"}}</span>
              </label>
            </div>
          </div>
          <div class="dcc-mob-combat-stat" data-tooltip="{{localize 'DCC.Defense.DamageResistance'}}">
            <span class="dcc-flabel">{{localize "DCC.Defense.DamageResistanceShort"}}</span>
            <span class="dcc-mob-total">{{system.damageResistance}}</span>
            <div class="dcc-mob-edit-fields">
              <label class="dcc-mob-part">
                <input class="dcc-mob-input" type="number" step="1" name="system.armor" value="{{systemSource.armor}}"
                       aria-label="{{localize 'DCC.Defense.Armor'}}">
                <span class="dcc-flabel">{{localize "DCC.Defense.Armor"}}</span>
              </label>
              <span class="dcc-mob-op">+</span>
              <span class="dcc-mob-part">
                <span class="dcc-mob-derived">{{system.damageResistanceBonus}}</span>
                <span class="dcc-flabel">{{localize "DCC.Defense.Buffs"}}</span>
              </span>
            </div>
          </div>
          {{#if spells.length}}
          <div class="dcc-mob-combat-stat">
            <span class="dcc-flabel">{{localize "DCC.Mana.Label"}}</span>
            <span class="dcc-mob-total">{{system.mana.value}}</span>
            <div class="dcc-mob-edit-fields">
              <label class="dcc-mob-part">
                <input class="dcc-mob-input" type="number" step="1" name="system.mana.value" value="{{systemSource.mana.value}}"
                       aria-label="{{localize 'DCC.Mana.Current'}}">
                <span class="dcc-flabel">{{localize "DCC.Mana.Current"}}</span>
              </label>
              <span class="dcc-mob-op">/</span>
              <label class="dcc-mob-part">
                <input class="dcc-mob-input" type="number" step="1" name="system.mana.max" value="{{systemSource.mana.max}}"
                       aria-label="{{localize 'DCC.Mana.Max'}}">
                <span class="dcc-flabel">{{localize "DCC.Mana.Max"}}</span>
              </label>
            </div>
          </div>
          {{/if}}
        </div>
      </div>
      {{> "systems/dungeon-crawler-carl/templates/actor/partials/unresolved.hbs"}}
    </div>

    <div class="dcc-box">
      <div class="dcc-bar">{{localize "DCC.Abilities"}}</div>
      <div class="dcc-mob-abilities{{#if spells.length}} dcc-mob-abilities--with-mana{{/if}}">
        {{#if editable}}
        <label class="dcc-mob-edit" data-tooltip="{{localize 'DCC.Mob.EditAbilities'}}">
          <input type="checkbox" name="system.mobAbilitiesEdit" {{checked systemSource.mobAbilitiesEdit}}
                 aria-label="{{localize 'DCC.Mob.EditAbilities'}}">
          <i class="fa-solid fa-pen-to-square" aria-hidden="true"></i>
        </label>
        {{/if}}
        <div class="dcc-stats" role="region" aria-label="{{localize 'DCC.Abilities'}}" tabindex="0">
          {{#each stats as |s|}}
          <div class="dcc-stat">
            <button type="button" class="dcc-statmod" data-action="rollAbility" data-stat="{{s.key}}"
              data-tooltip="{{localize s.label}}" aria-label="{{localize 'DCC.Roll.AbilityLabel' stat=(localize s.label)}}">{{localize (concat "DCC.Mob.StatAbbr." s.key)}}</button>
            <div class="dcc-mob-ability-value">
              <span class="dcc-statenh">{{s.enhancement}}</span>
              <span class="dcc-mob-ability-mod">({{numberFormat s.modifier sign=true}})</span>
            </div>
            <div class="dcc-mob-edit-fields">
              <label class="dcc-mob-part">
                <input class="dcc-mob-input" type="number" step="1" name="system.stats.{{s.key}}.base" value="{{s.base}}"
                       aria-label="{{localize 'DCC.Mob.AbilityBase' stat=(localize s.label)}}">
                <span class="dcc-flabel">{{localize "DCC.Mob.Base"}}</span>
              </label>
              <span class="dcc-mob-op">+</span>
              <span class="dcc-mob-part">
                <span class="dcc-mob-derived">{{s.buff}}</span>
                <span class="dcc-flabel">{{localize "DCC.Defense.Buffs"}}</span>
              </span>
            </div>
          </div>
          {{/each}}
        </div>
      </div>
    </div>
    {{> "systems/dungeon-crawler-carl/templates/actor/partials/attack-list.hbs" mob=true}}
    {{> "systems/dungeon-crawler-carl/templates/actor/partials/crewing.hbs"}}
    {{#if system.mobShowBuffs}}
    {{> "systems/dungeon-crawler-carl/templates/actor/partials/buff-list.hbs"}}
    {{/if}}
  </div>

  <div class="dcc-col dcc-col-r">
    {{!-- Weapons are listed under Attacks, so the inventory list contains gear only. --}}
    {{#if system.mobShowInventory}}
    <div class="dcc-box dcc-list">
      <div class="dcc-bar dcc-bar--list">
        <span>{{localize "DCC.Tab.inventory"}}</span>
        {{#if editable}}
        <button type="button" class="dcc-addbtn" id="{{@root.rootId}}-inv-add-gear" data-action="createItem" data-type="gear">
          <i class="fa-solid fa-plus" inert></i> {{localize "TYPES.Item.gear"}}
        </button>
        {{/if}}
      </div>
      <ol class="dcc-ilist dcc-ilist--inventory dcc-ilist--lean">
        <li class="dcc-ihead">
          <span>{{localize "DCC.Sheet.Name"}}</span>
          <span>{{localize "DCC.Inventory.Quantity"}}</span>
          <span>{{localize "DCC.Inventory.Active"}}</span>
          <span></span>
        </li>
        {{#each inventory}}
        {{#> "systems/dungeon-crawler-carl/templates/actor/partials/item-row.hbs" idSuffix="-inv"}}
          <span class="dcc-icell">
            <input class="dcc-iinput" type="number" step="1" id="{{@root.rootId}}-{{id}}-quantity" data-field="system.quantity" value="{{quantity}}"
                   aria-label="{{localize 'DCC.Inventory.Quantity'}}">
          </span>
          <span class="dcc-icell">
            <input class="dcc-icheck" type="checkbox" id="{{@root.rootId}}-{{id}}-active" data-field="system.active" {{checked active}}
                   data-tooltip="{{localize 'DCC.Inventory.ActiveTooltip'}}" aria-label="{{localize 'DCC.Inventory.Active'}}">
          </span>
        {{/"systems/dungeon-crawler-carl/templates/actor/partials/item-row.hbs"}}
        {{else}}
        <li class="dcc-iempty">{{localize "DCC.Inventory.NoItems"}}</li>
        {{/each}}
      </ol>
    </div>
    {{/if}}
    {{#if system.mobShowSkills}}
    {{> "systems/dungeon-crawler-carl/templates/actor/partials/skill-list.hbs" rows=skills lean=true}}
    {{> "systems/dungeon-crawler-carl/templates/actor/partials/skill-list.hbs" rows=spells spell=true lean=true}}
    {{/if}}
  </div>
</section>
